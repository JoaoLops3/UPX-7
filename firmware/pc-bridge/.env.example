# Copie para .env (mesmos valores do app / Supabase)

SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-service-role-ou-chave-com-insert-em-logs_nfc
TOTEM_ID=TOTEM-QUADRA-01

# Porta USB do Arduino (macOS: /dev/cu.usbmodem..., Windows: COM3)
# Deixe vazio para listar portas ao iniciar
SERIAL_PORT=

# TAG-NFC.ino usa 9600; upx7-totem-nfc.ino usa 115200
SERIAL_BAUD=9600
