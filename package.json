{
  "name": "UPX 7",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --lan",
    "dev": "expo start -c",
    "ios:sync-packager": "bash scripts/sync-ios-packager-host.sh",
    "ios:device": "bash scripts/sync-ios-packager-host.sh && expo run:ios --device",
    "build": "expo export -p web",
    "preview": "npx serve dist",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "ios:xcode": "open ios/UPX7.xcworkspace",
    "android:studio": "open -a 'Android Studio' android"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@expo/vector-icons": "~14.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/stack": "^7.2.10",
    "@supabase/supabase-js": "^2.49.1",
    "expo": "~52.0.46",
    "expo-asset": "~11.0.5",
    "expo-background-fetch": "~13.0.6",
    "expo-device": "~7.0.3",
    "expo-font": "~13.0.4",
    "expo-notifications": "~0.29.14",
    "expo-status-bar": "~2.0.1",
    "expo-task-manager": "~12.0.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "typescript": "~5.3.3"
  },
  "private": true
}
